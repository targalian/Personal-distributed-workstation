#!/usr/bin/env bash
# post-commit hook — 代码提交后自动更新 Qoder Repo Wiki
# 安装: core.hooksPath 指向 .githooks (与既有 hooks 一致, 无需手动复制)
# 守卫: wiki 自身提交跳过 / 无代码文件跳过 / 并发锁 10 分钟 / pending 合并
# 行为: 写 pending 队列 + 后台拉起 qoderclicn 无头 Agent (按 repowiki-update 技能执行)

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

REPO_ROOT=$(git rev-parse --show-toplevel)
WIKI_DIR="$REPO_ROOT/.qoder/repowiki"
PENDING_DIR="$WIKI_DIR/.pending"
LOCK_FILE="$PENDING_DIR/.lock"
PENDING_TXT="$PENDING_DIR/pending-commits.txt"
COMMIT_HASH=$(git rev-parse HEAD)

echo "======================================"
echo " LAN Mesh Post-Commit Wiki 调度"
echo "======================================"

# ── 守卫 1: wiki 自身提交 (自动 commit 或纯 repowiki 变更) → 不递归触发
CHANGED=$(git -c core.quotepath=false show --name-only --format= HEAD | grep -v '^$')
NON_WIKI=$(echo "$CHANGED" | grep -v '^.qoder/repowiki/' || true)
if [ -z "$NON_WIKI" ]; then
    echo -e "${GREEN}[SKIP] wiki 自身提交 (${COMMIT_HASH:0:7}), 不递归触发${NC}"
    exit 0
fi

# ── 守卫 2: 仅代码/架构文件才触发 wiki 更新
CODE_PAT='^(lan_mesh/|main\.py$|config\.yaml$|scripts/|webui/|quicklan-main/src-tauri/|README\.md$|docs/design/)'
CODE_CHANGED=$(echo "$NON_WIKI" | grep -E "$CODE_PAT" || true)
if [ -z "$CODE_CHANGED" ]; then
    echo -e "${GREEN}[SKIP] 无代码/架构文件变更, wiki 无需更新${NC}"
    exit 0
fi
CODE_COUNT=$(echo "$CODE_CHANGED" | wc -l | tr -d ' ')
echo -e "检测到代码变更 ${YELLOW}${CODE_COUNT}${NC} 个文件, 提交 ${YELLOW}${COMMIT_HASH:0:7}${NC}"

# ── 写 pending 队列 (Agent 消费; 失败可重试) ──
mkdir -p "$PENDING_DIR"
echo "${COMMIT_HASH} $(date -Iseconds) ${CODE_COUNT}" >> "$PENDING_TXT"
echo -e "pending 已入队: ${GREEN}${PENDING_TXT}${NC}"

# ── 守卫 3: 并发锁 (10 分钟内已有任务在跑 → 只入队不重复拉起) ──
if [ -f "$LOCK_FILE" ]; then
    NOW=$(date +%s)
    LOCK_MTIME=$(stat -c %Y "$LOCK_FILE" 2>/dev/null || echo 0)
    LOCK_AGE=$((NOW - LOCK_MTIME))
    if [ "$LOCK_AGE" -lt 600 ]; then
        echo -e "${YELLOW}[QUEUE] 更新任务运行中 (lock 已存在 ${LOCK_AGE}s), 待办已合并, 不重复拉起${NC}"
        exit 0
    fi
    echo -e "${YELLOW}[RETRY] 旧 lock 已过期 (${LOCK_AGE}s), 重新拉起${NC}"
fi

# ── 后台拉起 qoderclicn (无头 Agent, 按 repowiki-update 技能执行) ──
touch "$LOCK_FILE"
if [ "$LAN_MESH_WIKI_DRY_RUN" = "1" ]; then
    rm -f "$LOCK_FILE"
    echo -e "${YELLOW}[DRY-RUN] 调试模式: 不拉起 Agent, 仅验证守卫与入队逻辑${NC}"
    exit 0
fi
if command -v qoderclicn >/dev/null 2>&1; then
    PROMPT="你是 LAN Mesh 项目的 Wiki 维护 Agent。请严格按 .qoder/skills/repowiki-update/SKILL.md 的流程执行: 1) 读取 .qoder/repowiki/.pending/pending-commits.txt 的待办提交; 2) git show 分析各提交变更; 3) 运行 python .qoder/skills/repowiki-update/scripts/scan_refs.py 扫描过时引用; 4) 按技能映射规则更新 .qoder/repowiki/ 下的 content 与 knowledge 条目; 5) 运行 scan_refs.py --verify 验证零残留; 6) 无文件变更时跳过提交直接清理; 有变更时 git add .qoder/repowiki 排除 .pending 后提交为 docs(station): 同步 repo wiki; 7) 清空 pending-commits.txt 并删除 .pending/.lock。禁止修改 .qoder/repowiki 以外的任何文件。"
    nohup qoderclicn -p "$PROMPT" -w "$REPO_ROOT" --permission-mode accept_edits > "$PENDING_DIR/agent-run.log" 2>&1 &
    AGENT_PID=$!
    echo -e "${GREEN}[TRIGGER] 已后台拉起 qoderclicn wiki 更新任务 (PID ${AGENT_PID})${NC}"
    echo -e "运行日志: ${GREEN}${PENDING_DIR}/agent-run.log${NC}"
else
    rm -f "$LOCK_FILE"
    echo -e "${YELLOW}[PENDING] 未找到 qoderclicn, 待办已入队${NC}"
    echo -e "${YELLOW}         下次 Agent 会话请按 repowiki-update 技能执行更新${NC}"
fi

exit 0
