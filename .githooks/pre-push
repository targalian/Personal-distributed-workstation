#!/usr/bin/env bash
# pre-push hook — LAN Mesh 上库前自动审核
# 安装: 放置于 .git/hooks/pre-push 并赋予执行权限

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

ERRORS=0
WARNINGS=0

echo "======================================"
echo " LAN Mesh Pre-Push 代码审核"
echo "======================================"

# ── 解析审核基线（双仓库: master→gitee/master, en→origin/main）──
UPSTREAM=$(git rev-parse --abbrev-ref @{upstream} 2>/dev/null || true)
if [ -z "$UPSTREAM" ] || ! git rev-parse --verify --quiet "$UPSTREAM" >/dev/null; then
    UPSTREAM="gitee/master"
fi
if git rev-parse --verify --quiet "$UPSTREAM" >/dev/null; then
    BASE="$UPSTREAM"
else
    BASE="HEAD~1"
fi
echo -e "审核基线: ${GREEN}${BASE}${NC}"
echo ""

# ── 收集待审核的 Python 文件 ──────────────────────────
CHANGED_PY=$(git diff --name-only --diff-filter=ACM "$BASE" -- '*.py' 2>/dev/null || git diff --name-only --diff-filter=ACM HEAD~1 -- '*.py' 2>/dev/null || true)

if [ -z "$CHANGED_PY" ]; then
    echo -e "${GREEN}[PASS] 无 Python 文件变更，跳过代码审核${NC}"
    exit 0
fi

echo ""
echo "待审核文件:"
echo "$CHANGED_PY" | sed 's/^/  /'
echo ""

# ── 1. Python 语法检查 ────────────────────────────────
echo "── 1. 语法检查 ──"
for f in $CHANGED_PY; do
    [ -f "$f" ] || continue
    if python -m py_compile "$f" 2>/dev/null; then
        echo -e "  ${GREEN}[PASS]${NC} $f"
    else
        echo -e "  ${RED}[FAIL]${NC} $f — 语法错误"
        ERRORS=$((ERRORS + 1))
    fi
done
echo ""

# ── 2. 硬编码 API Key 检测 ────────────────────────────
echo "── 2. 安全检查: 硬编码密钥 ──"
for f in $CHANGED_PY; do
    [ -f "$f" ] || continue
    # 检测常见 API Key 模式 (sk-xxx, key-xxx, Bearer xxx)
    MATCHES=$(grep -nE '(api_key|API_KEY|secret|SECRET|token|TOKEN)\s*=\s*["\x27][A-Za-z0-9_\-]{16,}' "$f" 2>/dev/null || true)
    if [ -n "$MATCHES" ]; then
        echo -e "  ${RED}[FAIL]${NC} $f — 疑似硬编码密钥:"
        echo "$MATCHES" | head -5 | sed 's/^/    /'
        ERRORS=$((ERRORS + 1))
    else
        echo -e "  ${GREEN}[PASS]${NC} $f"
    fi
done
echo ""

# ── 3. 函数长度检查 (>80 行) ─────────────────────────
echo "── 3. 函数长度检查 (上限 80 行) ──"
for f in $CHANGED_PY; do
    [ -f "$f" ] || continue
    LONG_FUNCS=$(python -c "
import ast, sys
try:
    with open('$f', encoding='utf-8') as fh:
        tree = ast.parse(fh.read())
    for node in ast.walk(tree):
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
            lines = node.end_lineno - node.lineno
            if lines > 80:
                print(f'    {node.name}() — {lines} 行 (行 {node.lineno}-{node.end_lineno})')
except: pass
" 2>/dev/null || true)
    if [ -n "$LONG_FUNCS" ]; then
        echo -e "  ${YELLOW}[WARN]${NC} $f — 超长函数:"
        echo "$LONG_FUNCS"
        WARNINGS=$((WARNINGS + 1))
    else
        echo -e "  ${GREEN}[PASS]${NC} $f"
    fi
done
echo ""

# ── 4. 模块 docstring 检查 ───────────────────────────
echo "── 4. 模块 docstring 检查 ──"
for f in $CHANGED_PY; do
    [ -f "$f" ] || continue
    # 跳过 __init__.py 和测试文件
    BASENAME=$(basename "$f")
    if [ "$BASENAME" = "__init__.py" ]; then
        echo -e "  ${GREEN}[SKIP]${NC} $f"
        continue
    fi
    HAS_DOC=$(python -c "
import ast
try:
    with open('$f', encoding='utf-8') as fh:
        tree = ast.parse(fh.read())
    doc = ast.get_docstring(tree)
    print('yes' if doc else 'no')
except: print('error')
" 2>/dev/null)
    if [ "$HAS_DOC" = "yes" ]; then
        echo -e "  ${GREEN}[PASS]${NC} $f"
    else
        echo -e "  ${YELLOW}[WARN]${NC} $f — 缺少模块级 docstring"
        WARNINGS=$((WARNINGS + 1))
    fi
done
echo ""

# ── 5. 公共函数类型标注检查 ──────────────────────────
echo "── 5. 类型标注检查 (公共函数) ──"
for f in $CHANGED_PY; do
    [ -f "$f" ] || continue
    MISSING_TYPES=$(python -c "
import ast
try:
    with open('$f', encoding='utf-8') as fh:
        tree = ast.parse(fh.read())
    for node in ast.walk(tree):
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):
            if node.name.startswith('_'): continue
            args = [a for a in node.args.args if a.arg != 'self']
            untyped = [a.arg for a in args if a.annotation is None]
            if untyped:
                print(f'    {node.name}() 参数缺少类型: {\", \".join(untyped)}')
except: pass
" 2>/dev/null || true)
    if [ -n "$MISSING_TYPES" ]; then
        echo -e "  ${YELLOW}[WARN]${NC} $f:"
        echo "$MISSING_TYPES"
        WARNINGS=$((WARNINGS + 1))
    else
        echo -e "  ${GREEN}[PASS]${NC} $f"
    fi
done
echo ""

# ── 6. 日志格式检查 ──────────────────────────────────
echo "── 6. 日志格式检查 ([模块名] 前缀) ──"
VALID_PREFIXES='AgentRuntime|PM|ModelRouter|Secretary|Worker|Discovery|DB|WS|Preflight|Station|Chat|Bot|Skill|Task|Project|Host|Rating'
for f in $CHANGED_PY; do
    [ -f "$f" ] || continue
    BAD_PRINT=$(grep -nE '^\s*print\(' "$f" 2>/dev/null | grep -vE "\[($VALID_PREFIXES)\]" | grep -v '# noqa' || true)
    if [ -n "$BAD_PRINT" ]; then
        echo -e "  ${YELLOW}[WARN]${NC} $f — 缺少标准前缀:"
        echo "$BAD_PRINT" | head -5 | sed 's/^/    /'
        WARNINGS=$((WARNINGS + 1))
    else
        echo -e "  ${GREEN}[PASS]${NC} $f"
    fi
done
echo ""

# ── 7. Commit Message 格式检查 ───────────────────────
echo "── 7. Commit Message 格式检查 ──"
COMMITS=$(git log --format="%s" "$BASE"..HEAD 2>/dev/null || git log --format="%s" HEAD~5..HEAD 2>/dev/null || true)
if [ -n "$COMMITS" ]; then
    VALID_TYPES='feat|fix|refactor|docs|chore|perf|test|ci|style'
    VALID_SCOPES='pm|runtime|router|api|ws|ui|config|discovery|db|auth|skill|station|deploy|scripts'
    BAD_MSG=0
    while IFS= read -r msg; do
        if echo "$msg" | grep -qE "^($VALID_TYPES)\(($VALID_SCOPES)\): .+"; then
            echo -e "  ${GREEN}[PASS]${NC} $msg"
        else
            echo -e "  ${YELLOW}[WARN]${NC} 格式不规范: $msg"
            echo "         期望: <type>(<scope>): <subject>"
            BAD_MSG=$((BAD_MSG + 1))
        fi
    done <<< "$COMMITS"
    WARNINGS=$((WARNINGS + BAD_MSG))
fi
echo ""

# ── 汇总 ─────────────────────────────────────────────
echo "======================================"
echo " 审核汇总"
echo "======================================"
echo -e "  错误 (Blocker): ${RED}${ERRORS}${NC}"
echo -e "  警告 (Warning): ${YELLOW}${WARNINGS}${NC}"
echo ""

if [ $ERRORS -gt 0 ]; then
    echo -e "${RED}审核未通过: 存在 $ERRORS 个错误，请修复后再上库。${NC}"
    echo "  提示: 使用 git push --no-verify 可跳过检查（不推荐）"
    exit 1
fi

if [ $WARNINGS -gt 0 ]; then
    echo -e "${YELLOW}审核通过 (有 $WARNINGS 个警告)，建议修复后重新提交。${NC}"
    echo -e "${GREEN}提示: 在 Qoder 中使用 /code-review 可获得更深入的 AI 审核。${NC}"
fi

if [ $ERRORS -eq 0 ] && [ $WARNINGS -eq 0 ]; then
    echo -e "${GREEN}审核全部通过！${NC}"
fi

exit 0
