    "/api/tasks/{task_id}/resume": {
      "post": {
        "summary": "Resume Task",
        "description": "iter-53: 断点恢复 — 从 PM 执行态快照续跑中断的任务。\n\n流程:\n1. 查找任务与最新快照 (无快照则 404)\n2. 任务状态重置为 running\n3. 本机重建 PM Agent 并从快照恢复 (保留已完成子任务输出,\n   重新分发未完成部分)",
        "operationId": "resume_task_api_tasks__task_id__resume_post",
        "parameters": [
          {
            "name": "task_id",
