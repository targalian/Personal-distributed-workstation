{
  "openapi": "3.1.0",
  "info": {
    "title": "FastAPI",
    "version": "0.1.0"
  },
  "paths": {
    "/api/resources": {
      "get": {
        "summary": "Get Model Resources",
        "description": "查询模型资源池汇总 (额度/已用/剩余/状态)。未启用时返回空列表。",
        "operationId": "get_model_resources_api_resources_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/resources/usage": {
      "post": {
        "summary": "Record Model Usage",
        "description": "记录 LLM 调用消耗 (模型 → 资源池自动匹配)。\n\n单条: {model, input_tokens, output_tokens, usage_id?,\n    task_id?, project_id?}\n批量 (R3 Worker 上报): {records: [{usage_id, model,\n    input_tokens, output_tokens, task_id?, project_id?}, ...]}\n    — usage_id 幂等去重。",
        "operationId": "record_model_usage_api_resources_usage_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": true,
                "type": "object",
                "title": "Payload"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/resources/cost": {
      "get": {
        "summary": "Get Cost By Task",
        "description": "R6: 成本分摊聚合 — 按 task_id 分组统计调用次数/token/金额。\n\n无归因记录 task_id 为空串 (前端展示为「未归因」)。",
        "operationId": "get_cost_by_task_api_resources_cost_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 100,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/resources/probe": {
      "post": {
        "summary": "Probe Model Balances",
        "description": "触发资源池服务商余额自动探测 (R2)。\n\n调用各家余额 API (SiliconFlow/DeepSeek/Moonshot/智谱), 结果\n缓存并附到 /api/resources 汇总; 未支持的服务商返回引导提示。",
        "operationId": "probe_model_balances_api_resources_probe_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/resources/config": {
      "get": {
        "summary": "Get Resources Config",
        "description": "读取资源配置 (UI 配置向导): 当前配置 + 模型目录 + 探测能力。",
        "operationId": "get_resources_config_api_resources_config_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      },
      "post": {
        "summary": "Save Resources Config",
        "description": "保存资源配置并热重载 (UI 配置向导)。\n\n校验不通过 → 400 携带具体错误; 保存前自动备份至 ~/.lan_mesh/backups/。\nF1: 任意节点均可保存 (不再限 Secretary) — 保存后与全网\n对端自动对齐, 主从无关。",
        "operationId": "save_resources_config_api_resources_config_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": true,
                "type": "object",
                "title": "Payload"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/secrets/fetch": {
      "get": {
        "summary": "Fetch Secrets",
        "description": "S3: 提供本机资源配置加密密文, 供新节点启动时拉取 (API Key 自动同步)。\n\n与 bootstrap-token 同一信任假设 (局域网成员); 密文受\nAES-256-GCM 保护, 无 mesh_token 无法解密。本机无可用\n密钥配置时返回空 blob (调用方幂等跳过)。",
        "operationId": "fetch_secrets_api_secrets_fetch_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/secrets/receive": {
      "post": {
        "summary": "Receive Secrets",
        "description": "S1: 接收 Secretary 加密推送的资源配置 (含 API Key 直填)。\n\n解密用本机 mesh_token (与推送方同信任根, 与认证开关解耦);\n校验通过后落盘 resources.yaml 并热重载 (直填 key 由 load()\n注入环境变量); 配置指纹一致时幂等跳过。",
        "operationId": "receive_secrets_api_secrets_receive_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": true,
                "type": "object",
                "title": "Payload"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/secrets/sync-all": {
      "post": {
        "summary": "Sync Secrets All",
        "description": "F1: 手动触发全网密钥对齐 (角色无关, config_ts 仲裁)。",
        "operationId": "sync_secrets_all_api_secrets_sync_all_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/resources/test-key": {
      "post": {
        "summary": "Test Resource Key",
        "description": "单个 API Key 有效性测试 + 余额查询 (UI 一键测试)。",
        "operationId": "test_resource_key_api_resources_test_key_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": true,
                "type": "object",
                "title": "Payload"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/resources/alerts/check": {
      "post": {
        "summary": "Check Resource Alerts",
        "description": "R7: 手动触发一轮到期/额度预警检查 (返回新推送的预警)。",
        "operationId": "check_resource_alerts_api_resources_alerts_check_post",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/resources/rotation": {
      "get": {
        "summary": "Get Rotation Plan",
        "description": "R5: 多池轮换调度方案 — 逐模型候选池优先级与选中池。",
        "operationId": "get_rotation_plan_api_resources_rotation_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/events/recent": {
      "get": {
        "summary": "Get Recent Events",
        "description": "M5: 最近事件查询 (事件总线历史, 供 UI 补拉)。",
        "operationId": "get_recent_events_api_events_recent_get",
        "parameters": [
          {
            "name": "n",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20,
              "title": "N"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/roles": {
      "get": {
        "summary": "Get Role Cards",
        "description": "M6: 角色卡摘要 (Secretary/PM/Worker 人格单一事实源, 供 UI/quest 页面展示)。",
        "operationId": "get_role_cards_api_roles_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}