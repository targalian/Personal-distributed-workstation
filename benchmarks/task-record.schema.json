{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "system_version",
    "model",
    "task_id",
    "input_hash",
    "acceptance_hash",
    "run_id",
    "attempt",
    "duration_ms",
    "usage",
    "human_intervention",
    "acceptance_evidence",
    "recovery_conclusion",
    "fixture"
  ],
  "properties": {
    "system_version": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "parameters"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object"
        }
      }
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "input_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "acceptance_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "duration_ms": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "usage": {
      "type": "object",
      "required": [
        "input_tokens",
        "output_tokens",
        "currency",
        "cost"
      ],
      "properties": {
        "input_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "output_tokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "currency": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "cost": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "cost": {
                "type": "number"
              }
            }
          },
          "then": {
            "properties": {
              "currency": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "human_intervention": {
      "type": "boolean"
    },
    "acceptance_evidence": {
      "type": "object",
      "required": [
        "status",
        "refs",
        "verification"
      ],
      "properties": {
        "status": {
          "enum": [
            "unverified",
            "verified",
            "rejected"
          ]
        },
        "refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "verification": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "method",
            "verifier",
            "verified_at"
          ],
          "properties": {
            "method": {
              "type": "string",
              "minLength": 1
            },
            "verifier": {
              "type": "string",
              "minLength": 1
            },
            "verified_at": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "verified"
              }
            }
          },
          "then": {
            "properties": {
              "refs": {
                "minItems": 1
              },
              "verification": {
                "type": "object"
              }
            }
          }
        }
      ]
    },
    "recovery_conclusion": {
      "enum": [
        "not_assessed",
        "succeeded",
        "failed"
      ]
    },
    "fixture": {
      "type": "boolean"
    }
  }
}
